node_modules/
dist/
*.log

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini
.vscode/

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory, except the
# subagent definitions in .claude/agents/ and the hook scripts they run in
# .claude/hooks/, which are part of the harness and hold no settings or keys.
.claude/*
!.claude/agents/
!.claude/hooks/

# the local SQLite database (the deployed one lives on the Fly volume)
data/
.localdata/
.demodata/

# raw OpenStreetMap answers for scripts/streets.ts; the built map is public/streets.json
.osm-cache/
